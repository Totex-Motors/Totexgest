# Variáveis do servidor MCP (cadastre na Vercel → Project → Settings → Environment Variables).
# Nunca comitar valores reais. NUNCA usar chave secreta/service_role aqui.

# URL pública do servidor + /mcp (o domínio que a Vercel te der). Precisa terminar em /mcp.
MCP_PUBLIC_URL=https://SEU-DOMINIO-VERCEL/mcp

# Projeto Supabase do Totexgest.
SUPABASE_URL=https://mztfyavuclqzivywkaeu.supabase.co

# Chave PUBLICÁVEL (anon) do projeto — pública por natureza. Nunca a secreta.
SUPABASE_PUBLISHABLE_KEY=eyJ...ANON...

# Registro dinâmico de clientes OAuth (o Claude se registra sozinho). Recomendado: true.
MCP_DYNAMIC_CLIENTS=true

# (Opcional) Se preferir travar em clientes fixos em vez de dinâmicos, liste os IDs:
# MCP_OAUTH_CLIENT_IDS=uuid-1,uuid-2
